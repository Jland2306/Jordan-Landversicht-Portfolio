{
  "name": "jordan-landversicht-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh-pages": "cross-env DEPLOY_TARGET=gh-pages tsc -b && cross-env DEPLOY_TARGET=gh-pages vite build",
