    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
